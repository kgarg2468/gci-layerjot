OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DB_PATH=./backend/chroma_db
DOCS_PATH=./backend/docs
MOCK_PATIENT_DB_PATH=./backend/data/mock_patients.json
HOST=127.0.0.1
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Mac client
BACKEND_WS_URL=ws://127.0.0.1:8000/ws
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=en
MAX_RECORD_SECONDS=20
SAMPLE_RATE=16000
DEFAULT_PATIENT_ID=PAT-123
DEFAULT_SCREEN=home
